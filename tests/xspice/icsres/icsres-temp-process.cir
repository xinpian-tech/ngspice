a8 n8 0 null null r8
.model r8 icsres (variant=8 l=2u w=1.5u mr=2 resmis_mod=1 flag_cc=1 drsh=.003 ddw=1n dcox=1u dcapsw=2p sigma_mis=.75)
v9 n9 0 .7
a9 n9 0 null null r9
.model r9 icsres (variant=9 l=2u w=1.5u mr=2 resmis_mod=1 flag_cc=1 drsh=.003 ddw=1n dcox=1u dcapsw=2p sigma_mis=.75)
v10 n10 0 .7
a10 n10 0 null null r10
.model r10 icsres (variant=10 l=2u w=1.5u mr=2 resmis_mod=1 flag_cc=1 drsh=.003 ddw=1n dcox=1u dcapsw=2p sigma_mis=.75)
v11 n11 0 .7
